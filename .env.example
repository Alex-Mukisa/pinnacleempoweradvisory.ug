# Copy this file to .env and set credentials on the server only.
# Leave AI_API_KEY empty to use the built-in company FAQ assistant.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
PORT=8000
# Company enquiry recipient; can be changed per environment.
CONTACT_EMAIL=pinnacleempoweradvisory@gmail.com
# Resend account credentials are required for direct contact-form delivery.
# Verify the sender domain in Resend before setting RESEND_FROM_EMAIL.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Pinnacle Empower Advisory <website@your-verified-domain.com>
